generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(cuid())
  fullName         String
  email            String    @unique
  phone            String    @unique
  password         String
  role             Role      @default(USER)
  emailVerified    Boolean   @default(false)
  phoneVerified    Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  dob              DateTime?
  addressLine1     String?
  addressLine2     String?
  city             String?
  isDefaultAddress Boolean   @default(true)
  landmark         String?
  pincode          String?
  state            String?
  orders           Order[]

  @@map("users")
}

model OTP {
  id        String   @id @default(cuid())
  code      String
  type      OTPType
  email     String?
  phone     String?
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otps")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Product {
  id              String      @id @default(cuid())
  familyId        String?
  name            String
  description     String?
  price           Float
  stock           Int
  category        String
  images          String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  brand           String
  colors          Json        @default("[]")
  colorVariants   Json[]      @default([])
  isBestSeller    Boolean     @default(false)
  isFeatured      Boolean     @default(false)
  isNew           Boolean     @default(false)
  isNewArrival    Boolean     @default(false)
  isWeeklyTrending Boolean     @default(false)
  originalPrice   Float?
  discount        Float?
  rating          Float?
  ratingsCount    Int?
  reviewsCount    Int?
  reviewCount     Int?
  specs           Json?
  highlights      Json        @default("{}")
  bookingCount    Int         @default(0)

  // Variant tracking fields
  baseProductId   String?
  colorName       String?
  colorHex        String?
  storageOption   String?

  orderItems      OrderItem[]

  @@index([familyId])
  @@map("products")
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  total       Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  addressText String?
  latitude    Float?
  longitude   Float?
  items       OrderItem[]
  user        User        @relation(fields: [userId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_otps")
}

model Notification {
  id           String           @id @default(cuid())
  kind         String?          @default("repair")
  name         String?
  mobileNumber String?
  phoneBrand   String?
  phoneModel   String?
  issues       Json             @default("[]")
  otherIssue   String?          @default("")
  visitDate    String?          @default("")
  message      String
  replied      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  type         NotificationType @default(REPAIR)
  title        String?
  data         Json?
  expiresAt    DateTime?

  @@map("notifications")
}

model content_settings {
  id          String    @id @default(dbgenerated("gen_random_uuid()"))
  hero        Json?
  technicians Json?
  gallery     Json?
  services    Json?
  updated_at  DateTime? @default(now()) @db.Timestamp(6)
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}

model ImageAsset {
  id        String   @id @default(cuid())
  section   String
  title     String?
  imageUrl  String
  publicId  String
  createdAt DateTime @default(now())

  @@index([section])
}

model AdminResource {
  id        String   @id @default(cuid())
  type      String
  title     String?
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("admin_resources")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([active])
  @@map("push_subscriptions")
}

enum Role {
  USER
  ADMIN
}

enum OTPType {
  EMAIL_VERIFICATION
  PHONE_LOGIN
  PASSWORD_RESET
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum NotificationType {
  REPAIR
  CONTACT
  ORDER
  CART_ORDER
}
