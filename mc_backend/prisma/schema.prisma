generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  fullName      String
  email         String    @unique
  phone         String    @unique
  password      String
  role          Role      @default(USER)
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  dob           DateTime?
  // Address fields directly in user table
  addressLine1        String?
  addressLine2        String?
  city                String?
  state               String?
  pincode             String?
  landmark            String?
  isDefaultAddress    Boolean  @default(true)
  orders              Order[]

  @@map("users")
}

model OTP {
  id        String   @id @default(cuid())
  code      String
  type      OTPType
  email     String?
  phone     String?
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otps")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  displayName String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Product {
  id            String      @id @default(cuid())
  name          String
  description   String?
  price         Float
  stock         Int
  category      String
  images        String[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  brand         String
  colorVariants Json[]      @default([])
  isBestSeller  Boolean     @default(false)
  isFeatured    Boolean     @default(false)
  isNew         Boolean     @default(false)
  originalPrice Float?
  discount      Float?
  specs         Json?
  highlights    Json        @default("{}")
  bookingCount  Int         @default(0)
  orderItems    OrderItem[]

  @@map("products")
}

model Order {
  id          String      @id @default(cuid())
  userId      String
  total       Float
  status      OrderStatus @default(PENDING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  addressText String?
  latitude    Float?
  longitude   Float?
  items       OrderItem[]
  user        User        @relation(fields: [userId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model PasswordResetOtp {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_otps")
}

enum Role {
  USER
  ADMIN
}

enum OTPType {
  EMAIL_VERIFICATION
  PHONE_LOGIN
  PASSWORD_RESET
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum NotificationType {
  REPAIR
  CONTACT
  ORDER
  CART_ORDER
}

model Notification {
  id           String           @id @default(cuid())
  // legacy fields (kept for backward compatibility with existing UI)
  kind         String?          @default("repair")
  name         String?
  mobileNumber String?
  phoneBrand   String?
  phoneModel   String?
  issues       Json             @default("[]")
  otherIssue   String?          @default("")
  visitDate    String?          @default("")
  message      String
  replied      Boolean          @default(false)
  createdAt    DateTime         @default(now())

  // new unified model fields
  type         NotificationType @default(REPAIR)
  title        String?
  data         Json?
  expiresAt    DateTime?

  @@map("notifications")
}
